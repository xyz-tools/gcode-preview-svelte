{
  "name": "gcode-preview-svelte",
  "version": "0.1.0",
  "private": true,
  "description": "Svelte 5 component for gcode-preview: renders a 3D print preview of G-code on a canvas",
  "keywords": [
    "gcode",
    "g-code",
    "3d-printing",
    "preview",
    "svelte",
    "svelte5",
    "component",
    "threejs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyz-tools/gcode-preview-svelte.git"
  },
  "homepage": "https://github.com/xyz-tools/gcode-preview-svelte#readme",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-package -i src/lib -o dist",
    "build:demo": "vite build",
    "preview": "vite preview",
    "prepack": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint"
  },
  "peerDependencies": {
    "gcode-preview": "^3.0.0-alpha.6",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "gcode-preview": "3.0.0-alpha.6",
    "jsdom": "^30.1.2",
    "publint": "^0.3.25",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
